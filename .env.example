# Copy to .env.local for local work. Never commit real values.

# Postgres. Local default is the PGlite server from `npm run db:local`; use a Neon URL when deployed.
DATABASE_URL=postgres://postgres@127.0.0.1:54330/postgres
# Long random string that signs session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin of the app, used in links and for the same-origin check.
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that become admin after their first successful magic-link sign-in (never at signup).
ADMIN_EMAILS=
# Shared secret the cron route expects as `Authorization: Bearer <value>`. Vercel Cron sends it when CRON_SECRET is set.
CRON_SECRET=
# Vercel Blob token for photo/cover uploads (in development, empty means files are saved under public/uploads; production refuses uploads without it).
BLOB_READ_WRITE_TOKEN=

# Roqqu API Service mode: practice (simulated, no keys) | test (staging key) | live
# Required in production (test or live). Leave empty locally: no keys means practice mode. "practice" in production also needs ALLOW_PRACTICE=true.
RAS_MODE=
ALLOW_PRACTICE=false
RAS_TEST_KEY=
RAS_LIVE_KEY=
# Must be exactly "true" before live mode will move real money.
ALLOW_PRODUCTION_EXECUTION=false

# Email (Brevo). With no key, codes and sign-in links are shown on screen in development only.
BREVO_API_KEY=
BREVO_SENDER=

# Money rules (these are the defaults)
PLATFORM_FEE_BPS=500
NGN_PAYOUT_FEE=50
DAILY_WITHDRAW_USD=500

# Used only by the scripts: seed-demo.mjs needs a password for the demo account.
# BASE_URL=http://localhost:3000
# DEMO_PASSWORD=
